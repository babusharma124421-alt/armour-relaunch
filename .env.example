# Backend credentials
GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=

# Alert provider: twilio or fast2sms
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=

# Runtime URLs
BACKEND_WS_URL=ws://localhost:8000
VITE_BACKEND_HTTP_URL=http://localhost:8000
VITE_BACKEND_WS_URL=ws://localhost:8000

# Comma-separated origins in production. Use * for local development.
ALLOW_ORIGINS=*

# Optional model/runtime controls
VOICE_MODEL_LOCAL_ONLY=false
VOICE_HF_MODEL=mo-thecreator/deepfake-audio-detection
VOICE_DEVICE=cpu
